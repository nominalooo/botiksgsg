# ============================================================
# Crypto TG Scanner — конфигурация
# ============================================================

# --- Telegram API credentials (обязательно для скана ботов) ---
# Получить: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# --- Прокси для Telegram (опционально) ---
# Форматы:
#   http://user:pass@host:port
#   socks5://host:port
#   socks5://user:pass@host:port
#   host:port  (будет трактоваться как SOCKS5)
TG_PROXY=

# --- Exa API ключ (опционально, для нейросетевого поиска ботов) ---
# https://exa.ai — улучшает поиск обменников по смыслу
EXA_API_KEY=

# --- Стартовый список ботов (через запятую) ---
# Можно оставить пустым — база наполнится через "Найти новых ботов"
BOTS=